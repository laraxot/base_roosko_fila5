# Roosko in produzione: copiare in .env, compilare i valori tra <>, poi `php artisan key:generate`
# (solo alla prima installazione: la chiave cifra anche la password del certificato RENTRI).
# Verifica dopo il rilascio: php artisan roosko:production-check

APP_NAME=Roosko
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Rome
APP_URL=https://<dominio>
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT
# Rotazione della chiave: la vecchia va qui, cosi' i dati gia' cifrati restano leggibili.
APP_PREVIOUS_KEYS=

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<database>
DB_USERNAME=<utente>
DB_PASSWORD=<password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
# Deve superare il timeout dei job RENTRI (~150 s): vedi deploy/supervisor/roosko-workers.conf
DB_QUEUE_RETRY_AFTER=240

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=<smtp>
MAIL_PORT=587
MAIL_USERNAME=<utente>
MAIL_PASSWORD=<password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<noreply@dominio>
MAIL_FROM_NAME="${APP_NAME}"

# Stampanti di etichette e bilance raggiungibili solo in LAN o da questi host (separati da virgola).
LABELING_ALLOWED_PRINTER_HOSTS=
WEIGHING_ALLOWED_SCALE_HOSTS=

# RENTRI: le credenziali (certificato e password) si caricano dal pannello /rentri/admin.
RENTRI_POLLING_ENABLED=true

GOOGLE_MAPS_API_KEY=
